# MyFitPick production beta environment
# Copy to .env.local on the server and fill real values there only.

# App URL
NODE_ENV=production
APP_URL=
NEXT_PUBLIC_APP_URL=

# MongoDB
MONGODB_URI=

# Auth/session
JWT_SECRET=
SESSION_COOKIE_NAME=fitpick_session
# Plain HTTP EC2 IP testing needs false. Switch to true when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# Email OTP auth
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="MyFitPick <auth@myfitpick.com>"
OTP_CODE_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# OpenAI
OPENAI_API_KEY=
OPENAI_WARDROBE_MODEL=gpt-4.1-mini
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_STYLIST_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_RECOMMENDATION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_GENERATION_MODEL=gpt-image-1
OPENAI_IMAGE_PROMPT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# S3/CloudFront
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=
S3_BUCKET=
S3_REGION=eu-north-1
# Optional for local/static-key deployments. Leave both empty on EC2 when using an IAM role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDFRONT_PUBLIC_URL=
S3_PUBLIC_BASE_URL=

# Closet photo background removal (remove.bg)
BACKGROUND_REMOVAL_PROVIDER=remove_bg
REMOVE_BG_API_KEY=

# Background jobs
ENABLE_BACKGROUND_JOBS=true
WORKER_POLL_MS=5000
# PM2 routes Try-On to a dedicated worker. These values are set in ecosystem.config.js.
WORKER_JOB_TYPES=
WORKER_EXCLUDED_JOB_TYPES=
WORKER_ENABLE_MAINTENANCE=true

# Virtual Try-On (optional)
TRYON_PROVIDER=internal_preview
# Set TRYON_PROVIDER=fashn and configure the values below to use FASHN.
FASHN_API_KEY=
FASHN_BASE_URL=https://api.fashn.ai/v1
# Core tops, bottoms, and one-pieces use the faster clothing model.
# Outerwear, footwear, bags, watches, jewellery, and other finishers use Try-On Max.
FASHN_MODEL_NAME=tryon-max
FASHN_RESOLUTION=1k
FASHN_GENERATION_MODE=fast
FASHN_OUTPUT_FORMAT=png
# true keeps provider output out of temporary public provider storage, at the cost of larger responses.
FASHN_RETURN_BASE64=true
FASHN_MAX_OUTFIT_ITEMS=6
FASHN_TIMEOUT_MS=90000
FASHN_POLL_MS=3000

# Credit purchases
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# App Store credit purchases for the iOS wrapper.
# Configure these after creating consumable products in App Store Connect and RevenueCat.
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Keep false for Stripe-only launch. Set true only after CoinPayments is verified end to end.
COINPAYMENTS_CHECKOUT_ENABLED=false
COINPAYMENTS_API_BASE_URL=https://a-api.coinpayments.net/api/v2
COINPAYMENTS_CLIENT_ID=
COINPAYMENTS_CLIENT_SECRET=
COINPAYMENTS_WEBHOOK_SECRET=
COINPAYMENTS_WEBHOOK_URL=
COINPAYMENTS_USD_CURRENCY_ID=
# JSON array. Use exact CoinPayments providerCurrencyId values from your verified merchant account.
# Intended options: Tron/TRC20, BNB Smart Chain/BEP20, Ethereum/ERC20, Solana.
COINPAYMENTS_USDT_NETWORK_ALLOWLIST=

# Rate limiting/cache
AI_CACHE_PROVIDER=memory
REDIS_URL=
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_REDIS_URL=

# Human support chat
SUPPORT_CHAT_ENABLED=true
SUPPORT_REALTIME_PORT=3003
NEXT_PUBLIC_SUPPORT_REALTIME_URL=
# Optional dedicated signing secret. Falls back to JWT_SECRET when empty.
SUPPORT_SOCKET_TOKEN_SECRET=
SUPPORT_ATTACHMENT_MAX_BYTES=10485760
SUPPORT_MESSAGE_MAX_LENGTH=2000
# Comma-separated origins allowed to connect to the realtime service.
SUPPORT_ALLOWED_ORIGINS=https://myfitpick.com
STUDIO_MODEL_ASSET_GENERATION_ENABLED=false
STUDIO_MODEL_REQUIRE_HUMAN_APPROVAL=true
STUDIO_MODEL_INTEGRATION_TEST_ENABLED=false
STUDIO_MODEL_INTEGRATION_TEST_PREFIX=studio-model-integration/
# The deterministic recommendation is returned even when the optional AI
# explanation exceeds this budget.
STYLIST_AI_EXPLANATIONS_ENABLED=false
STYLIST_AI_EXPLANATION_TIMEOUT_MS=4500
